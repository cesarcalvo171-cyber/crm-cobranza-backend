# Configuración del Servidor
PORT=5000

# Credenciales de Supabase (Usa el Service Role Key para operaciones administrativas)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Clave Secreta para verificar Firmas HMAC-SHA256 del Banco
WEBHOOK_SECRET=your_bank_webhook_hmac_secret_here

# Endpoints de Webhook de n8n (Instalación Docker Local)
N8N_PAYMENT_WEBHOOK_URL=http://localhost:5678/webhook/payment-received
N8N_CAMPAIGN_WEBHOOK_URL=http://localhost:5678/webhook/campaign-send
