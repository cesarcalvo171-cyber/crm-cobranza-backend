# ─────────────────────────────────────────────────────────────────────────────
# CRM Cobranza Backend — Variables de Entorno
# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo .env a control de versiones.
# ─────────────────────────────────────────────────────────────────────────────

# ── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development       # development | production
PORT=5000

# ── Frontend — Para whitelist de CORS ────────────────────────────────────────
# En desarrollo: http://localhost:3000
# En producción: https://tu-dominio.com
FRONTEND_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Service Role Key: solo para uso server-side (nunca exponer al cliente)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Webhooks — Seguridad HMAC ─────────────────────────────────────────────────
# Clave secreta para verificar firmas HMAC-SHA256 del banco en /api/webhooks/*
WEBHOOK_SECRET=your_bank_webhook_hmac_secret_here

# ── n8n — URLs de Webhook de Automatización ──────────────────────────────────
N8N_PAYMENT_WEBHOOK_URL=http://localhost:5678/webhook/payment-received
N8N_CAMPAIGN_WEBHOOK_URL=http://localhost:5678/webhook/campaign-send
